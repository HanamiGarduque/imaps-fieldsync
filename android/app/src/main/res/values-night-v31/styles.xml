<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode Android 12+ variant: `night` outranks `v31` in qualifier
         resolution, so without this file a dark-mode API 31+ device would
         fall back to a non-blue system splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_fieldsync</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_blue</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_blue</item>
    </style>
</resources>
